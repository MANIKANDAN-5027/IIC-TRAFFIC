{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "{*.csv,data/**,district_data/**,templates/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    }
  ]
}
